# TTGQLDL — development environment template.
#
# Copy to `.env` in the repository root. `.env` is gitignored and must never be
# committed. The values below are DEVELOPMENT PLACEHOLDERS bound to loopback
# only; stage and production inject real secrets through the platform secret
# store and never use this file.
#
# See docs/plan/08_OPERATIONS.md ("Required configuration register").

# --- Runtime -----------------------------------------------------------------
TTG_ENV=dev
TTG_SOURCE=mock
TTG_HTTP_ADDR=127.0.0.1:8080
TTG_LOG_LEVEL=info
TTG_SHUTDOWN_TIMEOUT=10s
TTG_READINESS_TIMEOUT=2s
TTG_METRICS_ADDR=127.0.0.1:9090
TTG_MAX_QUEUE=20000
TTG_STREAM_RATE_HZ=5
TTG_SNAPSHOT_TICKS=600

# --- Identity (M03) ----------------------------------------------------------
# Development placeholder only. Stage/production require a real 32+ byte secret
# from the secret store; this value is deliberately public and worthless.
TTG_HMAC_KEY_VERSION=1
TTG_HMAC_SECRET=dev-placeholder-replace-me-0123456789abcdef

# --- PostgreSQL (development container) --------------------------------------
POSTGRES_DB=ttgqldl
POSTGRES_BOOTSTRAP_USER=ttg_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=dev-placeholder-replace-me
TTG_OWNER_PASSWORD=dev-placeholder-replace-me
TTG_APP_PASSWORD=dev-placeholder-replace-me
POSTGRES_PORT=5432
POSTGRES_DATA_VOLUME=ttgqldl_pgdata

# The backend connects as the least-privileged application role, never as the
# bootstrap superuser. Keep this URL in sync with TTG_APP_PASSWORD above.
TTG_DATABASE_URL=postgres://ttg_app:dev-placeholder-replace-me@127.0.0.1:5432/ttgqldl?sslmode=disable

# --- Privileged secrets (stage/production only) ------------------------------
# TTG_ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=2$...
# TTG_BOOTSTRAP_ADMIN_USER=
# TTG_STREAM_SIGNING_SECRET=
# TTG_SOURCE_CREDENTIAL_REF=
