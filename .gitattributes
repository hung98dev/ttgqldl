# Line endings that must not depend on the contributor's platform.
#
# Shell scripts are executed inside Linux containers and by Git Bash; a CRLF
# shebang fails with "bad interpreter". Go sources are handled by gofmt, but
# keeping them LF avoids noisy diffs on Windows checkouts.
*.sh   text eol=lf
*.bash text eol=lf
*.sql  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
.env*  text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Golden fixture digests are SHA-256 over the exact file bytes. A CRLF checkout
# on Windows would break fixture verification locally even though the committed
# bytes are unchanged, so the independently generated vectors and the backend copy
# must always be checked out with LF.
tooling/refeval/testdata/*.json text eol=lf
backend/testdata/golden/*.json   text eol=lf

# Binary assets are never normalised.
*.png  binary
*.jpg  binary
*.jpeg binary
*.wav  binary
*.ogg  binary

# Unity text-serialized assets are YAML; keep them LF so a Windows checkout does
# not rewrite every scene and prefab. Unity's YAML merger is not configured in
# this repository, so no merge driver is referenced here.
*.unity   text eol=lf
*.prefab  text eol=lf
*.asset   text eol=lf
*.mat     text eol=lf
*.meta    text eol=lf
*.asmdef  text eol=lf
*.asmref  text eol=lf
*.shader  text eol=lf